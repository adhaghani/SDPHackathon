# Supabase project (browser-safe values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only values. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Security and scheduling
CHECKIN_SIGNING_SECRET=at-least-32-random-bytes
CRON_SECRET=another-long-random-value

# Application URLs
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Demo mode. Keep false for a real pilot.
NEXT_PUBLIC_DEMO_MODE=true
DEMO_USER_PASSWORD=a-strong-demo-password

# Phase 5 feature flags. Keep false unless the stretch feature is being demoed.
NEXT_PUBLIC_ENABLE_RECOMMENDATIONS=false
NEXT_PUBLIC_ENABLE_ROTATING_QR=false
NEXT_PUBLIC_ENABLE_SPONSOR_PORTAL=false
NEXT_PUBLIC_ENABLE_AI_SEARCH=false
NEXT_PUBLIC_ENABLE_EQUIPMENT_HUBS=false
NEXT_PUBLIC_ENABLE_MULTI_TOWNSHIP=false
NEXT_PUBLIC_ENABLE_BM_UI=false
NEXT_PUBLIC_ENABLE_LEAFLET=false
NEXT_PUBLIC_ENABLE_REALTIME=false

# Optional notification email
RESEND_API_KEY=
EMAIL_FROM=BorrowLah <no-reply@example.com>

# Server-only AI configuration for photo suggestions, Help, and admin summaries.
# Supported providers: openai, mimo (also accepts Xiaomi MiMo).
# MiMo uses the OpenAI-compatible Chat Completions API, including image input.
AI_PROVIDER=mimo
AI_MODEL=mimo-v2.6-flash
AI_PROVIDER_LINK=https://api.xiaomimimo.com/v1
# For OpenAI: AI_PROVIDER=openai, AI_MODEL=gpt-4o-mini,
# AI_PROVIDER_LINK=https://api.openai.com/v1
# Leave the key empty to use manual/article/deterministic fallbacks.
# Admin summaries and natural-language search also need NEXT_PUBLIC_ENABLE_AI_SEARCH=true.
AI_API_KEY=
