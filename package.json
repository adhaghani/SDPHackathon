{
  "name": "next-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:watch": "npm run test --workspace web -- --watch",
    "test:e2e": "npm run test:e2e --workspace web",
    "test:db": "npm run demo:reset && supabase test db",
    "types:gen": "mkdir -p apps/web/types && supabase gen types typescript --local > apps/web/types/database.ts",
    "db:push": "supabase db push --local",
    "db:push:remote": "supabase db push",
    "seed": "tsx scripts/seed-demo.ts",
    "superadmin:grant": "tsx scripts/bootstrap-superadmin.ts",
    "emails:build": "tsx scripts/generate-email-templates.ts",
    "emails:check": "tsx scripts/generate-email-templates.ts --check",
    "emails:preview": "tsx scripts/generate-email-templates.ts --preview",
    "emails:export": "tsx scripts/generate-email-templates.ts --export",
    "demo:reset": "tsx scripts/reset-demo.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.20",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.120.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "ai": "^5.0.0",
    "leaflet": "^1.9.4",
    "motion": "^14.2.0",
    "next-intl": "^4.3.5",
    "react-leaflet": "^5.0.0"
  }
}
